# App
# URL pública da aplicação (ex.: http://localhost:3000 em dev).
NEXT_PUBLIC_APP_URL=

# Supabase (use as chaves e nomenclatura atuais do projeto Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — server only
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=

# Asaas — server only; definir base URL, credenciais e ambiente por deploy
# (ASAAS_ENVIRONMENT: "sandbox" ou "production")
ASAAS_API_KEY=
ASAAS_API_BASE_URL=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENVIRONMENT=

# Provedor de empresas — server only
# Valor usado nesta implementação: "minha_receita" — habilita a busca por
# CNAE/UF na base pública de CNPJ da Receita Federal via a API comunitária
# Minha Receita (minhareceita.org), gratuita, sem precisar de
# BUSINESS_PROVIDER_API_KEY. Ver docs/DECISIONS.md.
BUSINESS_PROVIDER=
BUSINESS_PROVIDER_API_KEY=
# Só usado se BUSINESS_PROVIDER=minha_receita; aponta para uma instância
# auto-hospedada (open-source, MIT) no lugar do servidor comunitário público.
BUSINESS_PROVIDER_BASE_URL=

# Verificação de presença digital (empresa tem site próprio ou não) — o sinal
# central de prospecção do FinderFlow AI. Nível gratuito da Brave Search API:
# 2.000 req/mês. Sem isso, o botão "Verificar site" mostra um estado honesto
# de "não configurado".
BRAVE_SEARCH_API_KEY=

# Jobs/cron — server only
CRON_SECRET=

# Testes de isolamento cross-tenant (apenas para Supabase local/dev, nunca
# produção; ex. de URL local: http://127.0.0.1:54321)
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
